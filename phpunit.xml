<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Cultiv One ships with Indonesian as the application default, but the bulk
             of this suite asserts on rendered UI copy in English and exists to test
             business rules, not translation. Pinning the test locale to English keeps
             those assertions meaningful instead of silently rewriting dozens of
             unrelated tests. Translation itself is covered on purpose in
             SettingsLocalizationTest, which switches locales explicitly, and in
             TranslationSyncTest, which drives both locales directly. -->
        <env name="APP_LOCALE" value="en"/>
        <!-- The gateway client refuses to call the provider without credentials, so the
             test environment must present itself as a configured installation. These are
             fake values that only ever travel into Http::fake(). -->
        <env name="QRISPW_API_KEY" value="test-key"/>
        <env name="QRISPW_API_SECRET" value="test-secret"/>
    </php>
</phpunit>
